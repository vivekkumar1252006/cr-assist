# ---- Server ----
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (and used for absolute links in emails)
CLIENT_ORIGIN=http://localhost:8080
CLIENT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartattend

# ---- Auth ----
# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# true  -> new accounts are 'pending' until the college activates them
# false -> new accounts are 'active' immediately
REQUIRE_APPROVAL=false
BCRYPT_ROUNDS=12

# ---- Transactional email (Gmail SMTP) ----
# Used for exactly three messages: admin notices, account creation (welcome), and
# the password reset OTP. Every other notification stays in-app.
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces are stripped automatically).
# Port 587 uses STARTTLS (SMTP_SECURE=false, SMTP_REQUIRE_TLS=true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM="CR-Assist <your.email@gmail.com>"

# ---- Password reset OTP ----
# The 6-digit code is emailed and stored only as a bcrypt hash.
OTP_TTL_MINUTES=5
# Wrong codes allowed per code before it is invalidated
OTP_MAX_ATTEMPTS=5
# Codes that may be requested per email inside the window below
OTP_MAX_REQUESTS=3
OTP_REQUEST_WINDOW_MINUTES=15
# Minimum wait before another code can be requested for the same email
OTP_RESEND_COOLDOWN_SECONDS=60
# How long the verified browser session may take to submit the new password
OTP_RESET_TICKET_TTL_MINUTES=10

# ---- Attendance ----
# Lifetime of the signed attendance QR shown to students during an active session
ATTENDANCE_TOKEN_TTL_SECONDS=45
# Scans later than this many minutes after the session start are recorded as "late"
LATE_AFTER_MINUTES=15
# Attendance below this percentage is highlighted on the dashboard
MIN_ATTENDANCE_PERCENT=75

# ---- Uploads ----
# Profile photos are stored in <UPLOAD_DIR>/avatars (relative to server/)
UPLOAD_DIR=uploads

# ---- Complaints ----
COMPLAINT_MAX_FILE_MB=10
COMPLAINT_MAX_FILES=10
# Let students reopen a resolved complaint (once, within N days)
ALLOW_COMPLAINT_REOPEN=true
COMPLAINT_REOPEN_DAYS=14
COMPLAINT_MAX_REOPENS=1
COMPLAINT_SUBMIT_LIMIT_PER_HOUR=5
