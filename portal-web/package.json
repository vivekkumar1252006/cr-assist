{
  "name": "smartattend-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "build:all": "npm run build",
    "preview": "vite preview",
    "start": "npm --prefix server start",
    "setup:accounts": "npm --prefix server run setup:accounts",
    "admin:create": "npm --prefix server run admin:create",
    "db:init": "npm --prefix server run db:init",
    "test:e2e": "npm --prefix server run test:e2e"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
